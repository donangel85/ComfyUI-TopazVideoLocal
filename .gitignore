__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local, machine-specific configuration — never commit
config.json
user_presets.json

# Logs and temporary run data
*.log
temp/

# Research, documentation and test footage live OUTSIDE this repository (siblings
# in the parent folder) so they cannot be committed by accident. These entries
# only matter if the repository is ever moved.
research/
docs/

# The owner's own video and photographs, used to verify the nodes against real
# material. Never part of the package and never published.
Testmaterial/
testmaterial/

# CI scratch: the captured pytest output, see .github/workflows/tests.yml
pytest.out
